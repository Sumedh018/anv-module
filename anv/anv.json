/**
 * ShiroX / Sora Module: ANV
 * Handles search, details, episode listings, and stream extraction.
 */

/**
 * Normalizes string output across native fetch and fetchv2 environments.
 * @param {string} url - The URL to fetch.
 * @param {Object} options - The fetch options.
 * @returns {Promise<string|null>} - The raw string body or null on failure.
 */
async function soraFetch(url, options = { headers: {}, method: 'GET', body: null }) {
    try {
        const res = await fetchv2(url, options.headers ?? {}, options.method ?? 'GET', options.body ?? null);
        return typeof res === 'string' ? res : JSON.stringify(res);
    } catch (e) {
        try {
            const res = await fetch(url, options);
            if (!res.ok) {
                console.log(`HTTP error! status: ${res.status}`);
                return null;
            }
            return await res.text();
        } catch (error) {
            console.log('soraFetch error: ' + error.message);
            return null;
        }
    }
}

/**
 * Searches for anime based on a keyword.
 * @param {string} keyword - The search keyword.
 * @returns {Promise<string>} - A JSON string array of search results.
 */
async function searchResults(keyword) {
    try {
        if (!keyword || typeof keyword !== 'string') {
            return JSON.stringify([]);
        }

        const encodedKeyword = encodeURIComponent(keyword.trim());
        const responseText = await soraFetch(`https://api.anv.to/search?q=${encodedKeyword}&language=dub`);
        if (!responseText) return JSON.stringify([]);

        const data = JSON.parse(responseText);
        const animes = data?.data?.animes || [];

        // Prioritize dubbed entries if available, otherwise fallback to all matches
        const dubbedOnly = animes.filter(anime => anime?.episodes?.dub !== null && anime?.episodes?.dub !== undefined);
        const targetList = dubbedOnly.length > 0 ? dubbedOnly : animes;

        const transformedResults = targetList.map(anime => ({
            title: anime.name || 'Unknown Title',
            image: anime.poster || '',
            href: `https://anv.to/watch/${anime.id}`
        }));

        return JSON.stringify(transformedResults);
    } catch (error) {
        console.log('searchResults error:', error);
        return JSON.stringify([]);
    }
}

/**
 * Extracts metadata details of an anime from its watch URL.
 * @param {string} url - The URL of the anime page.
 * @returns {Promise<string>} - A JSON string array of the anime details.
 */
async function extractDetails(url) {
    try {
        const match = url.match(/\/watch\/([^?&/]+)/);
        if (!match) throw new Error('Invalid URL format');
        const animeId = match[1];

        const responseText = await soraFetch(`https://api.anv.to/anime/${animeId}`);
        if (!responseText) throw new Error('Empty response');

        const data = JSON.parse(responseText);
        const animeInfo = data?.data?.anime?.info || {};
        const moreInfo = data?.data?.anime?.moreInfo || {};

        const transformedResults = [{
            description: animeInfo.description || 'No description available',
            aliases: `Duration: ${animeInfo.stats?.duration || 'Unknown'}`,
            airdate: `Aired: ${moreInfo?.aired || 'Unknown'}`
        }];

        return JSON.stringify(transformedResults);
    } catch (error) {
        console.log('extractDetails error:', error);
        return JSON.stringify([{
            description: 'Could not load details.',
            aliases: 'Duration: Unknown',
            airdate: 'Aired: Unknown'
        }]);
    }
}

/**
 * Extracts the list of episodes for an anime.
 * @param {string} url - The URL of the anime page.
 * @returns {Promise<string>} - A JSON string array of episodes.
 */
async function extractEpisodes(url) {
    try {
        const match = url.match(/\/watch\/([^?&/]+)/);
        if (!match) throw new Error('Invalid URL format');
        const animeId = match[1];

        const responseText = await soraFetch(`https://api.anv.to/anime/${animeId}/episodes`);
        if (!responseText) return JSON.stringify([]);

        const data = JSON.parse(responseText);
        const episodes = data?.data?.episodes || [];

        const transformedResults = episodes.map(episode => {
            const rawEpId = String(episode.episodeId || '');
            const epParam = rawEpId.includes('?ep=') ? rawEpId.split('?ep=')[1] : rawEpId;

            return {
                href: `https://anv.to/watch/${animeId}?ep=${epParam}`,
                number: episode.number !== undefined ? episode.number : 1
            };
        });

        return JSON.stringify(transformedResults);
    } catch (error) {
        console.log('extractEpisodes error:', error);
        return JSON.stringify([]);
    }
}

/**
 * Extracts the direct video stream URL for a selected episode.
 * @param {string} url - The URL of the anime episode page.
 * @returns {Promise<string|null>} - Direct stream link or null.
 */
async function extractStreamUrl(url) {
    try {
        const epMatch = url.match(/[?&]ep=([^&#]+)/);
        const episodeId = epMatch ? epMatch[1] : null;

        if (!episodeId) {
            console.log('Missing episode ID in URL:', url);
            return null;
        }

        const responseText = await soraFetch(`https://api.anv.to/episode/sources?animeEpisodeId=${episodeId}&category=dub`);
        if (!responseText) return null;

        const data = JSON.parse(responseText);
        const sources = data?.data?.sources || [];
        const hlsSource = sources.find(source => source.type === 'hls') || sources[0];

        return hlsSource?.url || null;
    } catch (error) {
        console.log('extractStreamUrl error:', error);
        return null;
    }
}
